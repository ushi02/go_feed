# Copy to .env on the server and fill in. Never commit .env.
# Use only letters and digits in passwords: they are placed inside the MySQL DSN.

# Domain whose DNS A record points at this server. Caddy gets the certificate for it.
DOMAIN=feed.example.com

MYSQL_ROOT_PASSWORD=ChangeMeRoot1
MYSQL_USER=go_feed
MYSQL_PASSWORD=ChangeMeApp1

# Optional until the chatbot ships.
DEEPSEEK_API_KEY=
